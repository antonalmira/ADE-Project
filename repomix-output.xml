from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import QTreeWidgetItem
import os
import json
import re

global_tree_state = {}

def _strip_chapter_numbering(text):
    pattern = r'^(?:\d+\.(?:\d+\.?)*\s+|\d+(?:\.\d+)*\s*[-_]+\s+)(?![vV][aA]?[cCdD]?\b|[aA]\b|[mM][aA]\b|[wW]\b|[hH][zZ]\b|%)'
    return re.sub(pattern, '', text).strip()

def capture_tree_state(tree_widget, state_dict):
    def process_item(item):
        item_path = item.data(0, Qt.UserRole + 1)
        is_folder = item.data(0, Qt.UserRole + 2) in ["folder", "root"]
        if item_path:
            state_dict[item_path] = {
                "check_state": item.checkState(0),
                "crop": item.data(0, Qt.UserRole + 3),
                "caption": item.data(0, Qt.UserRole),
                "custom_name": item.text(0).replace(" [FOLDER CROPPED]", "").replace(" [IMAGE CROPPED]", "").strip(),
                "expanded": item.isExpanded(),
                "setup_table": item.data(0, Qt.UserRole + 11)
            }
            if is_folder:
                order = [item.child(i).data(0, Qt.UserRole + 4) for i in range(item.childCount()) if item.child(i).data(0, Qt.UserRole + 4)]
                state_dict[item_path]["order"] = order
                for i in range(item.childCount()): process_item(item.child(i))

    state_dict["__ROOT__"] = {
        "order": [tree_widget.topLevelItem(i).data(0, Qt.UserRole + 4) for i in range(tree_widget.topLevelItemCount())]
    }
    for i in range(tree_widget.topLevelItemCount()): process_item(tree_widget.topLevelItem(i))

def build_tree_recursive(parent_widget, current_path, state_dict, metadata=None, perf_dir=None):
    try: items = os.listdir(current_path)
    except PermissionError: return False

    saved_order = state_dict.get(current_path, {}).get("order", [])
    items.sort(key=lambda x: saved_order.index(x) if x in saved_order else 999999)

    for item_name in items:
        if item_name == "metadata.json": continue
        
        item_path = os.path.join(current_path, item_name)
        item_state = state_dict.get(item_path, {}) 
        is_dir = os.path.isdir(item_path)
        is_img = item_name.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp'))
        
        if not is_dir and not is_img: continue

        display_name = item_state.get("custom_name") or (item_name if is_dir else os.path.splitext(item_name)[0])
        new_item = QTreeWidgetItem([display_name])
        
        base_flags = new_item.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsDragEnabled | Qt.ItemIsEditable
        new_item.setFlags(base_flags | Qt.ItemIsAutoTristate | Qt.ItemIsDropEnabled if is_dir else base_flags & ~Qt.ItemIsDropEnabled)
        new_item.setCheckState(0, item_state.get("check_state", Qt.Checked))
            
        if item_state.get("crop"):
            new_item.setData(0, Qt.UserRole + 3, item_state["crop"])
            new_item.setText(0, f"{display_name}{' [FOLDER CROPPED]' if is_dir else ' [IMAGE CROPPED]'}") 
            
        cap = item_state.get("caption")
        if cap:
            new_item.setData(0, Qt.UserRole, cap)
            new_item.setBackground(0, Qt.darkBlue)

        new_item.setData(0, Qt.UserRole + 1, item_path)
        new_item.setData(0, Qt.UserRole + 2, "folder" if is_dir else "file")
        new_item.setData(0, Qt.UserRole + 4, item_name) 
        new_item.setData(0, Qt.UserRole + 6, display_name) 

        if metadata is not None:
            rel_key = os.path.relpath(item_path, perf_dir) if perf_dir and os.path.isabs(item_path) else item_path
            meta = metadata.get(rel_key) or metadata.get(item_path)
            if meta:
                new_item.setData(0, Qt.UserRole + 7, meta.get("type"))
                new_item.setData(0, Qt.UserRole + 8, meta.get("excel_path"))
                new_item.setData(0, Qt.UserRole + 9, meta.get("sheet_name"))
                new_item.setData(0, Qt.UserRole + 10, meta.get("voltage"))
                if is_dir: new_item.setData(0, Qt.UserRole + 11, meta.get("include_setup_table", False))
            elif is_dir: new_item.setData(0, Qt.UserRole + 11, item_state.get("setup_table", False))
        elif is_dir:
            new_item.setData(0, Qt.UserRole + 11, item_state.get("setup_table", False))

        if isinstance(parent_widget, QTreeWidgetItem): parent_widget.addChild(new_item)
        else: parent_widget.addTopLevelItem(new_item)

        if is_dir:
            build_tree_recursive(new_item, item_path, state_dict, metadata, perf_dir)
            new_item.setExpanded(item_state.get("expanded", False))

def update_unified_tree(app, capture=True):
    if capture: capture_tree_state(app.unified_tree, global_tree_state)
    app.unified_tree.blockSignals(True)
    app.unified_tree.clear()

    nodes_to_add = []
    
    # 1. Performance Data
    perf_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Performance Data")
    if os.path.exists(perf_dir):
        meta_path = os.path.join(perf_dir, "metadata.json")
        metadata = json.load(open(meta_path)) if os.path.exists(meta_path) else {}
        perf_state = global_tree_state.get(perf_dir, {})
        
        perf_node = QTreeWidgetItem([perf_state.get("custom_name", "Performance Data")])
        perf_node.setFlags(perf_node.flags() | Qt.ItemIsAutoTristate | Qt.ItemIsDropEnabled | Qt.ItemIsDragEnabled | Qt.ItemIsEditable)
        perf_node.setCheckState(0, perf_state.get("check_state", Qt.Checked))
        perf_node.setData(0, Qt.UserRole + 2, "root")
        perf_node.setData(0, Qt.UserRole + 1, perf_dir)
        perf_node.setData(0, Qt.UserRole + 4, "Performance Data")
        perf_node.setData(0, Qt.UserRole + 6, perf_state.get("custom_name", "Performance Data"))
        perf_node.setData(0, Qt.UserRole + 11, perf_state.get("setup_table", False))
        perf_node.setData(0, Qt.UserRole + 12, "excel") # Source Flag
        
        build_tree_recursive(perf_node, perf_dir, global_tree_state, metadata, perf_dir)
        perf_node.setExpanded(perf_state.get("expanded", True))
        nodes_to_add.append(perf_node)

    # 2. Linked Folders
    for folder_path in app.linked_folders:
        if os.path.exists(folder_path):
            folder_state = global_tree_state.get(folder_path, {})
            base_name = _strip_chapter_numbering(os.path.basename(folder_path))
            disp_name = folder_state.get("custom_name", base_name)
            
            node = QTreeWidgetItem([disp_name])
            node.setFlags(node.flags() | Qt.ItemIsAutoTristate | Qt.ItemIsDropEnabled | Qt.ItemIsDragEnabled | Qt.ItemIsEditable)
            node.setCheckState(0, folder_state.get("check_state", Qt.Checked))
            node.setData(0, Qt.UserRole + 2, "root")
            node.setData(0, Qt.UserRole + 1, folder_path)
            node.setData(0, Qt.UserRole + 4, base_name)
            node.setData(0, Qt.UserRole + 6, disp_name)
            node.setData(0, Qt.UserRole + 11, folder_state.get("setup_table", False))
            node.setData(0, Qt.UserRole + 12, "folder") # Source Flag
            
            build_tree_recursive(node, folder_path, global_tree_state)
            node.setExpanded(folder_state.get("expanded", True))
            nodes_to_add.append(node)

    # Sort root nodes based on saved order
    root_order = global_tree_state.get("__ROOT__", {}).get("order", [])
    nodes_to_add.sort(key=lambda n: root_order.index(n.data(0, Qt.UserRole + 4)) if n.data(0, Qt.UserRole + 4) in root_order else 999)
    
    for n in nodes_to_add: app.unified_tree.addTopLevelItem(n)
    app.unified_tree.blockSignals(False)

def sync_state_on_rename(old_path, new_path, old_name, new_name, parent_path):
    if parent_path in global_tree_state and "order" in global_tree_state[parent_path]:
        order_list = global_tree_state[parent_path]["order"]
        if old_name in order_list: order_list[order_list.index(old_name)] = new_name
            
    new_state = {}
    for k, v in global_tree_state.items():
        if k == old_path or k.startswith(old_path + os.sep):
            new_k = k.replace(old_path, new_path, 1)
            new_state[new_k] = v
        else: new_state[k] = v
    global_tree_state.clear()
    global_tree_state.update(new_state)

def sync_metadata_on_rename(old_path, new_path):
    perf_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Performance Data")
    meta_path = os.path.join(perf_dir, "metadata.json")
    if not os.path.exists(meta_path): return
    meta = json.load(open(meta_path))
    new_meta = {k.replace(old_path, new_path, 1) if k.startswith(old_path) else k: v for k, v in meta.items()}
    json.dump(new_meta, open(meta_path, 'w'))

def sync_metadata_on_delete(paths_to_delete):
    perf_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Performance Data")
    meta_path = os.path.join(perf_dir, "metadata.json")
    if not os.path.exists(meta_path): return
    meta = json.load(open(meta_path))
    new_meta = {k: v for k, v in meta.items() if not any(k.startswith(p) for p in paths_to_delete)}
    json.dump(new_meta, open(meta_path, 'w'))
