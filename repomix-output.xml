import os
import shutil
import json
import re
from PyQt5.QtCore import QThread, pyqtSignal
from PyQt5.QtWidgets import QFileDialog, QProgressDialog, QMessageBox
import win32com.client
import pythoncom
from excel_utils import peek_table_voltages
from list_updater import update_unified_tree

def select_template_file(app):
    current_dir = os.path.dirname(os.path.abspath(__file__))
    default_path = os.path.join(current_dir, "templates")
    if not os.path.exists(default_path): default_path = os.path.join(os.path.expanduser("~"), "Desktop")
    file, _ = QFileDialog.getOpenFileName(app, "Select Word Template", default_path, "Word Documents (*.docx)")
    if file: app.template_path_display.setText(file)

def select_bom_file(app):
    file, _ = QFileDialog.getOpenFileName(app, "Select Bill of Materials", "", "Excel Files (*.xlsx *.xls)")
    if file: app.bom_path_display.setText(file)

def select_pixls_file(app):
    file, _ = QFileDialog.getOpenFileName(app, "Select Design Spreadsheet", "", "Excel Files (*.xlsx *.xls)")
    if file: app.pix_path_display.setText(file)

def clear_all_data(app):
    app.unified_tree.clear()
    app.linked_folders.clear()
    perf_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Performance Data")
    if os.path.exists(perf_dir): shutil.rmtree(perf_dir)

# --- THE SMART "DOES BOTH" ENGINE ---
def process_master_folder(app):
    parent_dir = QFileDialog.getExistingDirectory(app, "Select Master Folder (e.g. Test Data)", "")
    if not parent_dir: return

    excel_files = []
    keywords = ['waveform', 'thermal', 'graph', 'table', 'overload', 'power']

    # 1. Walk the directory to find ALL Excel files
    for root, dirs, files in os.walk(parent_dir):
        for f in files:
            if f.lower().endswith(('.xlsx', '.xls', '.xlsm')) and not f.startswith('~'):
                excel_files.append(os.path.join(root, f))

    # Keep track of folders containing Excel files so we don't link them as empty duplicate folders
    excel_folders = {os.path.dirname(f) for f in excel_files}
    new_links = 0

    # 2. Check if the selected parent folder ITSELF matches the image keywords
    if any(kw in os.path.basename(parent_dir).lower() for kw in keywords):
        if parent_dir not in excel_folders:
            if parent_dir not in app.linked_folders:
                app.linked_folders.append(parent_dir)
                new_links += 1
    else:
        # Otherwise, check its immediate children for image folders
        for item in os.listdir(parent_dir):
            full_path = os.path.join(parent_dir, item)
            if os.path.isdir(full_path):
                # Smart exclusion: if this folder contains the Excel file we are extracting, skip linking it
                if full_path in excel_folders:
                    continue
                if any(kw in item.lower() for kw in keywords):
                    if full_path not in app.linked_folders:
                        app.linked_folders.append(full_path)
                        new_links += 1

    has_excels = len(excel_files) > 0
    has_links = new_links > 0

    if not has_excels and not has_links:
        QMessageBox.information(app, "No Data Found", "No Excel files or matching image folders found in this directory.")
        return

    # If Excel files exist, extract them first. The worker will call update_unified_tree when done.
    if has_excels:
        perf_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "Performance Data")
        if os.path.exists(perf_dir): shutil.rmtree(perf_dir)

        app.progress_dialog = QProgressDialog("Importing Excel Data...", "Cancel", 0, 100, app)
        app.progress_dialog.setWindowTitle("Processing")
        app.progress_dialog.setModal(True)
        app.progress_dialog.setMinimumDuration(0)
        app.progress_dialog.show()

        app.perf_worker = PerfImportWorker(excel_files, perf_dir)
        app.perf_worker.progress.connect(app.progress_dialog.setValue)
        app.perf_worker.finished.connect(lambda s, m: on_perf_import_finished(app, s, m))
        app.perf_worker.start()
    else:
        # If there are no Excel files, but we found linked folders, just update the UI
        update_unified_tree(app)

def on_perf_import_finished(app, success, msg):
    app.progress_dialog.close()
    if success: update_unified_tree(app)
    else: QMessageBox.warning(app, "Error", f"Excel Import failed: {msg}")


# --- EXCEL EXTRACTION ENGINE ---
def _map_sheet_to_category(sheet_name):
    name_lower = sheet_name.lower().replace("-", " ").replace("_", " ")
    if "no load" in name_lower: return "No-Load Input Power"
    if "line eff" in name_lower: return "Full Load Efficiency vs. Line"
    if "load eff" in name_lower or "efficiency vs" in name_lower: return "Efficiency vs. Load"
    if "line reg" in name_lower: return "Line Regulation"
    if "load reg" in name_lower or "load ref" in name_lower: return "Load Regulation"
    if "eff" in name_lower and "table" in name_lower: return "Average and 10% Efficiency"
    if "average" in name_lower or "10%" in name_lower: return "Average and 10% Efficiency"
    return re.sub(r'\((Graph|Table|graph|table)\)', '', name_lower).strip().title()

class PerfImportWorker(QThread):
    progress = pyqtSignal(int, str)
    finished = pyqtSignal(bool, str)

    def __init__(self, excel_paths, perf_dir):
        super().__init__()
        self.excel_paths = excel_paths
        self.perf_dir = perf_dir

    def run(self):
        pythoncom.CoInitialize()
        excel = None
        try:
            self.progress.emit(5, "Opening Excel...")
            excel = win32com.client.DispatchEx("Excel.Application")
            excel.Visible = False
            excel.DisplayAlerts = False
            os.makedirs(self.perf_dir, exist_ok=True)
            metadata = {}
            total_files = len(self.excel_paths)

            if total_files == 0:
                raise ValueError("No files selected.")

            for file_idx, excel_path in enumerate(self.excel_paths):
                base_pct = 5 + (file_idx / total_files) * 90
                next_pct = 5 + ((file_idx + 1) / total_files) * 90
                filename = os.path.basename(excel_path)
                self.progress.emit(int(base_pct), f"Processing {filename}...")

                wb = excel.Workbooks.Open(os.path.abspath(excel_path), ReadOnly=True)
                try:
                    sheets = [s for s in wb.Sheets if re.search(r'\((Graph|Table)\)', s.Name, re.IGNORECASE)]
                    if not sheets: continue

                    for i, sheet in enumerate(sheets):
                        pct = int(base_pct + (i / len(sheets)) * (next_pct - base_pct))
                        self.progress.emit(pct, f"Extracting {sheet.Name} from {filename}...")

                        category = _map_sheet_to_category(sheet.Name)
                        cat_dir = os.path.join(self.perf_dir, category)
                        os.makedirs(cat_dir, exist_ok=True)

                        is_table = "(Table)" in sheet.Name
                        png_name = f"{os.path.splitext(filename)[0]} - {sheet.Name}.png" if total_files > 1 else f"{sheet.Name}.png"
                        
                        rel_png = os.path.join(os.path.relpath(cat_dir, self.perf_dir), png_name)
                        png_path = os.path.abspath(os.path.join(cat_dir, png_name))

                        try:
                            if is_table:
                                rng = sheet.UsedRange
                                rng.CopyPicture(Appearance=1, Format=2)
                                chart_obj = sheet.ChartObjects().Add(0, 0, rng.Width, rng.Height)
                                chart_obj.Chart.Paste()
                                chart_obj.Chart.Export(png_path, "PNG")
                                chart_obj.Delete()
                            else:
                                if sheet.Type in [-4169, 3]: sheet.Export(png_path, "PNG")
                                elif sheet.ChartObjects().Count > 0: sheet.ChartObjects(1).Chart.Export(png_path, "PNG")
                        except Exception as e: print(f"Failed to export png for {sheet.Name}: {e}")

                        if not os.path.exists(png_path): continue

                        if is_table:
                            voltages = peek_table_voltages(excel_path, sheet.Name)
                            if voltages:
                                for volt in voltages:
                                    split_name = f"{os.path.splitext(filename)[0]} - {sheet.Name} - {volt} VAC" if total_files > 1 else f"{sheet.Name} - {volt} VAC"
                                    split_png_abs = os.path.abspath(os.path.join(cat_dir, f"{split_name}.png"))
                                    split_rel = os.path.join(os.path.relpath(cat_dir, self.perf_dir), f"{split_name}.png")
                                    shutil.copy(png_path, split_png_abs)
                                    metadata[split_rel] = { "type": "table", "excel_path": excel_path, "sheet_name": sheet.Name, "voltage": volt }
                                os.remove(png_path)
                                continue

                        metadata[rel_png] = { "type": "table" if is_table else "graph", "excel_path": excel_path, "sheet_name": sheet.Name, "voltage": None }
                finally:
                    try: wb.Close(SaveChanges=False)
                    except: pass

            with open(os.path.join(self.perf_dir, "metadata.json"), "w") as f: json.dump(metadata, f)
            self.progress.emit(100, "Done!")
            self.finished.emit(True, "Success")
        except Exception as e: self.finished.emit(False, str(e))
        finally:
            if excel is not None:
                try: excel.Quit()
                except: pass
            pythoncom.CoUninitialize()
