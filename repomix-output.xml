from PyQt5.QtCore import Qt
from PyQt5.QtGui import QBrush, QColor, QFont
from PyQt5.QtWidgets import QListWidgetItem, QTreeWidgetItem
import os
import re
import json
from pathlib import Path
from utils import get_resource_path, ensure_directory
from excel_utils import peek_table_voltages

# --- PERFORMANCE CONFIGURATION ---
DEFAULT_PERFORMANCE = {
    "efficiency test": "Efficiency Test", "line regulation": "Line Regulation Test", "load regulation": "Load Regulation",
    "no load": "No load Input Power Test", "power factor": "Power Factor", "load transient": "Load Transient Response",
    "output voltage": "Output Voltage Distortion", "line input": "Line Input Harmonic Content",
    "led dimming": "LED Dimming Test", "thermal test": "Thermal Test", "standby input": "Standby Input Power"
}

config_dir = os.path.join(str(Path.home()), '.docuapp')
ensure_directory(config_dir)
user_perf_path = os.path.join(config_dir, 'performancedata_testnames.json')
bundled_perf_path = get_resource_path('performancedata_testnames.json')
performancedata_testnames = DEFAULT_PERFORMANCE.copy()

if os.path.exists(user_perf_path):
    try:
        with open(user_perf_path, 'r', encoding='utf-8') as f: performancedata_testnames = json.load(f)
    except Exception: pass
elif os.path.exists(bundled_perf_path):
    try:
        with open(bundled_perf_path, 'r', encoding='utf-8') as f: performancedata_testnames = json.load(f)
    except Exception: pass


# --- PERFORMANCE TREE ENGINE & STATE CACHE ---

global_perf_state = {}

def capture_perf_state(app):
    global global_perf_state
    for i in range(app.performance_tree.topLevelItemCount()):
        parent = app.performance_tree.topLevelItem(i)
        parent_name = parent.text(0).replace(" [CROP SET]", "")
        
        global_perf_state[parent_name] = {"check_state": parent.checkState(0), "order": []}
        for j in range(parent.childCount()):
            child = parent.child(j)
            node_name = child.text(0).replace(" [CROP SET]", "")
            global_perf_state[parent_name]["order"].append(node_name)
            global_perf_state[node_name] = {
                "check_state": child.checkState(0),
                "crop": child.data(0, Qt.UserRole + 3),
                "caption": child.data(0, Qt.UserRole),
                "custom_name": child.text(0).replace(" [CROP SET]", "") # Save UI renames
            }

def get_excel_sheets(file_path):
    import win32com.client
    import pythoncom
    pythoncom.CoInitialize()
    sheets = []
    excel = None
    try:
        excel = win32com.client.DispatchEx("Excel.Application")
        excel.Visible = False
        excel.DisplayAlerts = False
        wb = excel.Workbooks.Open(os.path.abspath(file_path), ReadOnly=True)
        for sheet in wb.Sheets:
            sheets.append(sheet.Name)
        wb.Close(SaveChanges=False)
    except Exception as e:
        print(f"Failed to read sheets: {e}")
    finally:
        if excel: excel.Quit()
        pythoncom.CoUninitialize()
    return sheets

def update_performance_tree(app):
    capture_perf_state(app)
    app.performance_tree.clear()

    excel_path = app.performancedata_path.text().strip()
    if not excel_path or not os.path.isfile(excel_path): return

    sheet_names = get_excel_sheets(excel_path)
    
    target_sheets = [s for s in sheet_names if re.search(r'\((Graph|Table)\)', s, re.IGNORECASE)]
    if not target_sheets: return

    file_name = os.path.basename(excel_path)
    parent_state = global_perf_state.get(file_name, {})
    saved_order = parent_state.get("order", [])

    file_node = QTreeWidgetItem([file_name])
    file_node.setFlags(file_node.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsAutoTristate | Qt.ItemIsDropEnabled)
    file_node.setCheckState(0, parent_state.get("check_state", Qt.Checked))
    file_node.setData(0, Qt.UserRole + 1, excel_path) 
    file_node.setData(0, Qt.UserRole + 2, "folder") 
    file_node.setExpanded(True)

    final_nodes = []
    for sheet in target_sheets:
        if "(Table)" in sheet:
            voltages = peek_table_voltages(excel_path, sheet)
            if voltages:
                for volt in voltages:
                    final_nodes.append((f"{sheet} - {volt} VAC", sheet, volt))
            else:
                final_nodes.append((sheet, sheet, None))
        else:
            final_nodes.append((sheet, sheet, None))

    final_nodes.sort(key=lambda x: saved_order.index(x[0]) if x[0] in saved_order else 999999)

    for node_name, sheet, volt in final_nodes:
        sheet_state = global_perf_state.get(node_name, {})
        
        # Restore renamed string if it exists
        display_name = sheet_state.get("custom_name", node_name)
        sheet_item = QTreeWidgetItem([display_name])
        
        # ADDED ItemIsEditable flag
        sheet_item.setFlags((sheet_item.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsDragEnabled | Qt.ItemIsEditable) & ~Qt.ItemIsDropEnabled)
        sheet_item.setCheckState(0, sheet_state.get("check_state", Qt.Checked))
        
        if sheet_state.get("crop"):
            sheet_item.setData(0, Qt.UserRole + 3, sheet_state["crop"])
            sheet_item.setText(0, f"{display_name} [CROP SET]")
        
        cap = sheet_state.get("caption")
        if cap:
            sheet_item.setData(0, Qt.UserRole, cap)
            sheet_item.setBackground(0, Qt.darkBlue)
            
        sheet_item.setData(0, Qt.UserRole + 1, excel_path)
        sheet_item.setData(0, Qt.UserRole + 2, "file") 
        sheet_item.setData(0, Qt.UserRole + 4, sheet) 
        sheet_item.setData(0, Qt.UserRole + 5, volt)  

        file_node.addChild(sheet_item)
        
    app.performance_tree.addTopLevelItem(file_node)


# --- WAVEFORM N-TIER ENGINE & STATE CACHE ---

global_wave_state = {}

def capture_wave_state(app):
    global global_wave_state
    def process_item(item):
        item_path = item.data(0, Qt.UserRole + 1)
        is_folder = item.data(0, Qt.UserRole + 2) == "folder"
        if item_path:
            global_wave_state[item_path] = {
                "check_state": item.checkState(0), 
                "crop": item.data(0, Qt.UserRole + 3), 
                "caption": item.data(0, Qt.UserRole),
                "custom_name": item.text(0).replace(" [CROP SET]", "") # Save UI renames
            }
            if is_folder:
                order = [item.child(i).data(0, Qt.UserRole + 4) for i in range(item.childCount()) if item.child(i).data(0, Qt.UserRole + 4)]
                global_wave_state[item_path]["order"] = order
                for i in range(item.childCount()): process_item(item.child(i))

    root_paths = {os.path.dirname(app.waveform_tree.topLevelItem(i).data(0, Qt.UserRole + 1)) 
                  for i in range(app.waveform_tree.topLevelItemCount()) if app.waveform_tree.topLevelItem(i).data(0, Qt.UserRole + 1)}
            
    for rp in root_paths:
        if rp not in global_wave_state: global_wave_state[rp] = {}
        global_wave_state[rp]["order"] = [app.waveform_tree.topLevelItem(i).data(0, Qt.UserRole + 4) 
                                          for i in range(app.waveform_tree.topLevelItemCount()) 
                                          if app.waveform_tree.topLevelItem(i).data(0, Qt.UserRole + 1) and os.path.dirname(app.waveform_tree.topLevelItem(i).data(0, Qt.UserRole + 1)) == rp]
    
    for i in range(app.waveform_tree.topLevelItemCount()): process_item(app.waveform_tree.topLevelItem(i))

def update_waveform_tree(app):
    capture_wave_state(app)
    app.waveform_tree.clear()
    valid_paths = [p.strip() for p in app.waveforms_path.text().split(';') if p.strip() and os.path.isdir(p.strip())]
    for path in valid_paths: build_tree(app.waveform_tree, path)

def build_tree(parent_widget, current_path):
    try: items = os.listdir(current_path)
    except PermissionError: return False

    saved_order = global_wave_state.get(current_path, {}).get("order", [])
    items.sort(key=lambda x: saved_order.index(x) if x in saved_order else 999999)

    for item_name in items:
        item_path = os.path.join(current_path, item_name)
        item_state = global_wave_state.get(item_path, {}) 
        is_dir = os.path.isdir(item_path)
        is_img = item_name.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp'))
        
        if not is_dir and not is_img: continue

        # Fetch custom UI rename if it exists, otherwise clean the raw file name
        display_name = item_state.get("custom_name")
        if not display_name:
            display_name = re.sub(r'^[\d\.\s\-_]+', '', item_name).strip()
            if not display_name: display_name = item_name

        new_item = QTreeWidgetItem([display_name])
        
        # ADDED ItemIsEditable flag so user can double click to edit
        base_flags = new_item.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsDragEnabled | Qt.ItemIsEditable
        if is_dir: new_item.setFlags(base_flags | Qt.ItemIsAutoTristate | Qt.ItemIsDropEnabled)
        else: new_item.setFlags(base_flags & ~Qt.ItemIsDropEnabled)
        
        new_item.setCheckState(0, item_state.get("check_state", Qt.Checked))
            
        if item_state.get("crop"):
            new_item.setData(0, Qt.UserRole + 3, item_state["crop"])
            new_item.setText(0, f"{display_name} [CROP SET]") 
            
        cap = item_state.get("caption")
        if cap:
            new_item.setData(0, Qt.UserRole, cap)
            new_item.setBackground(0, Qt.darkBlue)

        new_item.setData(0, Qt.UserRole + 1, item_path)
        new_item.setData(0, Qt.UserRole + 2, "folder" if is_dir else "file")
        new_item.setData(0, Qt.UserRole + 4, item_name) # Hidden original name for sorting

        # UNCONDITIONALLY ADD TO THE UI (Even if empty)
        if isinstance(parent_widget, QTreeWidgetItem): 
            parent_widget.addChild(new_item)
        else: 
            parent_widget.addTopLevelItem(new_item)

        # If it's a directory, recursively scan inside it
        if is_dir:
            new_item.setExpanded(True)
            build_tree(new_item, item_path)

